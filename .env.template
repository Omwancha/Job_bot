# ─────────────────────────────────────────────
# JobBot — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git — add it to .gitignore
# ─────────────────────────────────────────────

# ── Your notification email ──────────────────
NOTIFY_EMAIL=you@gmail.com

# ── Gmail SMTP (for sending the daily digest) ─
# Use a Gmail App Password — NOT your real password
# Get one at: https://myaccount.google.com/apppasswords
# (Requires 2FA to be enabled on your Google account)
GMAIL_SENDER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Gmail OAuth2 (for auto-apply / send-as-you) ─
# Only needed if auto_apply_enabled = true in profile.json
# Create credentials at: https://console.cloud.google.com
# Enable the Gmail API, create OAuth2 Desktop credentials
# Download the JSON and paste the path below
GMAIL_OAUTH_CREDENTIALS_PATH=./credentials/gmail_oauth.json
GMAIL_OAUTH_TOKEN_PATH=./credentials/gmail_token.json

# ── Anthropic API (for CV tailoring + cover emails) ─
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Scraper settings ─────────────────────────
# Comma-separated list of sources to scrape
SCRAPE_SOURCES=fuzu,myjobmag,brightermonday

# Comma-separated role keywords to match
ROLE_KEYWORDS=data analyst,analytics engineer,BI analyst,business intelligence,power bi,dbt

# Location filter
LOCATION=Nairobi

# Only show jobs posted within this many days (14 = 2 weeks)
MAX_AGE_DAYS=14

# ── Database ──────────────────────────────────
DB_PATH=./jobbot.db

# ── Schedule ──────────────────────────────────
# Time to run the daily scrape (24hr format, local time)
RUN_TIME=08:00

# ── Optional: Selenium (headless-browser rendering) ─
# Set to true to render Fuzu's JavaScript keyword search with headless Chrome
# (requires Google Chrome installed; Selenium resolves its own driver).
# Without it, Fuzu returns only its default unfiltered listing.
USE_SELENIUM=false
SELENIUM_HEADLESS=true
